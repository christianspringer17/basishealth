{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install hero video from Downloads",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/install-hero-video.ps1"
      ],
      "windows": {
        "options": {
          "shell": {
            "executable": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
          }
        },
        "command": "& '${workspaceFolder}/scripts/install-hero-video.ps1'"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
