{
  "name": "basishealth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-dev.mjs",
    "dev:clean": "node scripts/clean-dev-cache.mjs && node scripts/start-dev.mjs",
    "dev:fast": "next dev --turbo",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "predev": "node scripts/check-node.mjs && node scripts/ensure-dev-cache.mjs",
    "prebuild": "node scripts/check-node.mjs",
    "video:hero": "powershell -ExecutionPolicy Bypass -File scripts/install-hero-video.ps1",
    "video:visual": "powershell -ExecutionPolicy Bypass -File scripts/install-visual-video.ps1",
    "poster:hero": "powershell -ExecutionPolicy Bypass -File scripts/extract-poster.ps1 -Video public/videos/hero.mp4 -Output public/images/hero-poster.jpg",
    "poster:herovid2": "powershell -ExecutionPolicy Bypass -File scripts/extract-poster.ps1 -Video public/videos/herovid2.mp4 -Output public/images/herovid2-poster.jpg",
    "poster:opengraph": "powershell -ExecutionPolicy Bypass -File scripts/extract-opengraph-hero.ps1",
    "poster:visual": "powershell -ExecutionPolicy Bypass -File scripts/extract-poster.ps1 -Video public/videos/visual.mp4 -Output public/images/visual-poster.jpg",
    "images:nav": "node scripts/install-nav-images.mjs"
  },
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.76",
    "next": "^15.5.18",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.18",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
