# Public site URL (used for Open Graph metadata)
NEXT_PUBLIC_SITE_URL=https://basis.care

# MyDose whitelabel checkout / intake URL — CTAs switch when set (otherwise /#waitlist)
# NEXT_PUBLIC_MYDOSE_CHECKOUT_URL=https://whitelabel.mydose.ai/your-clinic

# GoHighLevel application form — iframe embed URL from Sites → Forms → Embed
# When set, replaces the built-in waitlist form on /#waitlist (CTA href stays /#waitlist)
# NEXT_PUBLIC_GHL_FORM_EMBED_URL=https://api.leadconnectorhq.com/widget/form/YOUR_FORM_ID

# Analytics (optional — configure at least one for CRO tracking)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=basis.care

# Waitlist — configure at least one backend:

# Option A: Create GitHub issues for each signup (recommended for this repo)
WAITLIST_GITHUB_TOKEN=ghp_...
GITHUB_REPO=christianspringer17/basishealth

# Option B: Email notifications via Resend (https://resend.com)
RESEND_API_KEY=re_...
WAITLIST_NOTIFY_EMAIL=support@basis.care
WAITLIST_FROM_EMAIL=onboarding@resend.dev

# Option C: Web3Forms (https://web3forms.com)
WEB3FORMS_ACCESS_KEY=...

# Optional hero / section videos (MP4). Or place files in public/videos/
NEXT_PUBLIC_HERO_VIDEO_URL=/videos/hero.mp4
NEXT_PUBLIC_VISUAL_VIDEO_URL=/videos/visual.mp4

# Optional social profile URLs (footer links go to /connect until set)
# NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/basishealth
# NEXT_PUBLIC_TWITTER_URL=https://twitter.com/basishealth
# NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@basishealth
# NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/basishealth
